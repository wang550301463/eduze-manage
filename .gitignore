# Maven build output
target/

# Application logs
logs/
*.log

# IntelliJ IDEA
*.iml
.idea/

# Eclipse / VS Code
.classpath
.project
.settings/
.factorypath
.vscode/

# OS junk
.DS_Store
Thumbs.db

# Frontend (web/) build artifacts
web/node_modules/
web/dist/
*.tsbuildinfo

# Spring Boot static resources are produced by Maven from web/dist; never commit
src/main/resources/static/**

# Docker local secrets / TLS keys
docker/.env
docker/certs/server.key
docker/certs/server.crt

# Local DB backups (never commit dumps)
backups/
*.sql.gz
*.sql.gz.sha256

web/test-results/
web/playwright-report/

# Socrates brainstorm companion sessions
.socrates/
*.sql.gz

# Git worktrees
.worktrees/

# Platform local credentials and generated clients
docker/platform/.env*
!docker/platform/.env.example
docker/platform/certs/
miniapp/node_modules/
miniapp/dist/
miniapp/miniprogram/
miniapp/project.private.config.json
packages/*/node_modules/
storage/

docker/platform/payment-keys/

# Python validation caches
__pycache__/
*.pyc
