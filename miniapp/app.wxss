page{background:#f3f4ed;color:#263d37;font-family:system-ui;font-size:28rpx}.page{padding:32rpx;padding-bottom:72rpx}.eyebrow{font-size:22rpx;letter-spacing:4rpx;color:#52736a}.title{font-size:44rpx;font-weight:600;margin:14rpx 0 20rpx}.muted{color:#72807a;font-size:25rpx;line-height:1.7}.card{background:rgba(255,255,255,.82);border:2rpx solid white;border-radius:32rpx;padding:28rpx;margin:24rpx 0;box-shadow:0 10rpx 30rpx #263d3708}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.stack>*{margin-bottom:20rpx}button{font-size:28rpx;border-radius:20rpx;background:#396b5c;color:white;margin:16rpx 0}button.secondary{background:#eef2e9;color:#396b5c}button[disabled]{opacity:.5}.label{font-size:25rpx;color:#526a60;margin:20rpx 0 10rpx}input,textarea,picker{background:#f3f5ef;border-radius:16rpx;padding:20rpx;box-sizing:border-box;width:100%}textarea{min-height:160rpx}.error{background:#fff1ee;color:#963e35;padding:24rpx;border-radius:20rpx;margin:20rpx 0}.success{color:#327251;padding:16rpx}.tag{font-size:22rpx;color:#527565;background:#edf2e9;padding:8rpx 14rpx;border-radius:10rpx}.image{width:100%;border-radius:20rpx;margin:12rpx 0}.divider{border-bottom:1rpx solid #dfe5db;padding:20rpx 0}
