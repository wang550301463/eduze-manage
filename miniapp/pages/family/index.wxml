<view class="page"><view class="eyebrow">GROWING TOGETHER</view><view class="title">孩子的成长</view><button class="secondary" bindtap="growth">成长报告 / 历史作品 / 私人精选集</button><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load">重新加载</button></view><view wx:if="{{success}}" class="success">{{success}}</view><view class="card"><view class="row"><view>剩余可用课时</view><view class="title">{{remainingLessons}}</view></view><view class="muted">完整课效发布与扣课分别记录。</view></view><view class="card"><view class="title">未来课堂</view><view wx:for="{{schedule}}" wx:key="id" class="divider"><view>{{item.startTime}}</view><view class="muted">至 {{item.endTime}} · {{item.status}}</view><button class="secondary" size="mini" data-id="{{item.id}}" bindtap="selectLesson">申请请假</button></view><view wx:if="{{!schedule.length}}" class="muted">暂无后续课堂安排。</view><view wx:if="{{lessonId}}"><textarea value="{{reason}}" bindinput="reason" placeholder="请假原因"/><button bindtap="leave" disabled="{{busy || !reason}}">提交请假申请</button></view><view wx:for="{{leaves}}" wx:key="id" class="muted">请假申请：{{item.status}}</view></view><view class="card" wx:if="{{entries.length}}"><view class="title">每次课堂动态</view><view wx:for="{{entries}}" wx:key="id" class="divider"><view class="muted">{{item.occurredAt}}</view><view>{{item.notes}}</view><button wx:if="{{item.mediaIds.length}}" class="secondary" data-id="{{item.id}}" bindtap="entry">查看课堂照片</button></view></view><view class="card"><view class="title">主题课效</view><view wx:for="{{records}}" wx:key="id" class="divider" data-id="{{item.id}}" bindtap="record"><view>{{item.content.classroomNote || '老师的主题学习回顾'}}</view><view class="muted">{{item.content.artworks.length}} 件过程与作品 · 点击查看</view></view><view wx:if="{{!records.length}}" class="muted">老师发布后，主题学习回顾会出现在这里。</view></view><view wx:if="{{opened}}" class="card"><view class="title">主题学习回顾</view><view>{{opened.content.classroomNote}}</view><block wx:for="{{images}}" wx:key="id"><video wx:if="{{item.kind==='video'}}" src="{{item.url}}" controls class="image"/><audio wx:elif="{{item.kind==='audio'}}" src="{{item.url}}" controls/><image wx:else class="image" src="{{item.displayUrl || item.url}}" mode="widthFix"/></block><view wx:for="{{opened.content.artworks}}" wx:key="id" class="divider"><view>{{item.title}}</view><view class="muted">{{item.story}}</view></view><view class="label">老师寄语</view><view>{{opened.content.comment}}</view></view><view class="card" wx:if="{{reports.length}}"><view class="title">阶段成长回顾</view><view wx:for="{{reports}}" wx:key="id" class="divider"><view>{{item.title}}</view><view class="muted">{{item.summary}}</view></view></view><view class="card" wx:if="{{publications.length}}"><view class="title">公开展览授权</view><view class="muted">公开展示与家庭查看分别授权。仅授权你选择的这份课效版本，可以随时撤销。</view><view class="label">对外展示昵称</view><input value="{{displayName}}" bindinput="displayName" placeholder="默认：小画家"/><view wx:for="{{publications}}" wx:key="id" class="divider"><view>{{item.content.classroomNote || '主题学习回顾'}}</view><view class="muted">{{item.createdAt}} · {{item.content.artworks.length}} 件作品</view><button class="secondary" data-id="{{item.id}}" bindtap="publication">查看这个发布版本的作品</button><button class="secondary" data-id="{{item.id}}" data-allowed="true" bindtap="consent" disabled="{{busy}}">同意此版本公开参展</button><button class="secondary" data-id="{{item.id}}" data-allowed="false" bindtap="consent" disabled="{{busy}}">撤销此版本公开授权</button></view></view></view>
