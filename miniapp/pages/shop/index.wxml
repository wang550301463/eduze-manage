<view class="page"><view class="eyebrow">KEEP CREATING</view><view class="title">画室商城</view><view wx:if="{{error}}" class="error">{{error}}</view><picker range="{{studios}}" range-key="name" bindchange="branch">{{branchName}}</picker><button class="secondary" bindtap="orders">我的订单与售后</button><view class="card" wx:if="{{selected}}"><view class="title">{{selected.title}}</view><view>{{selected.description}}</view><view class="label">单价 ¥ {{selected.priceText}}</view><view class="label">购买数量</view><input type="number" value="{{quantity}}" data-field="quantity" bindinput="field"/><view wx:if="{{selected.type==='COURSE'}}"><view class="label">课程使用人</view><picker range="{{children}}" range-key="name" bindchange="child">{{childName}}</picker><view class="muted">每份含 {{selected.lessonUnits}} 课时。购买成功后发放课时，具体班级与时段由画室安排。</view></view><view wx:if="{{selected.type==='PHYSICAL'}}"><view class="row"><button class="secondary" data-method="PICKUP" bindtap="method">画室自提</button><button class="secondary" data-method="DELIVERY" bindtap="method">配送到家</button></view><view class="muted">已选：{{fulfillmentMethod==='DELIVERY'?'配送到家':'画室自提'}}</view><view wx:if="{{fulfillmentMethod==='DELIVERY'}}"><view class="label">收件人</view><input value="{{recipientName}}" data-field="recipientName" bindinput="field"/><view class="label">联系电话</view><input type="number" value="{{recipientPhone}}" data-field="recipientPhone" bindinput="field"/><view class="label">详细地址</view><textarea value="{{address}}" data-field="address" bindinput="field"/></view></view><button bindtap="order" disabled="{{busy || !quantity}}" loading="{{busy}}">确认下单，前往订单支付</button><view class="muted">最终金额以服务端生成的订单为准。</view></view><view class="card" wx:for="{{products}}" wx:key="id"><view class="tag">{{item.type==='COURSE'?'课程服务':item.type==='ACTIVITY'?'活动门票':'画材与服务'}}</view><view class="title">{{item.title}}</view><view class="muted">{{item.description}}</view><view class="row"><view>¥ {{item.priceText}}</view><view class="muted">剩余 {{item.stock}}</view></view><button class="secondary" data-id="{{item.id}}" bindtap="select" disabled="{{item.stock<1 || busy}}">{{item.stock<1?'暂时售罄':'查看并购买'}}</button></view><view wx:if="{{!products.length && !busy}}" class="card muted">当前画室暂无上架商品。</view></view>
