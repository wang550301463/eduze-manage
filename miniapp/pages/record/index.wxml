<view class="page"><view class="title">记录创作过程</view><view class="muted">手机与 PC 共用草稿。云端版本 {{record.version}}</view><view class="error" wx:if="{{error}}">{{error}}</view><view class="success" wx:if="{{success}}">{{success}}</view><view wx:if="{{draft}}" class="card"><view class="label">创作进度</view><picker range="{{progressLabels}}" value="{{progressIndex}}" bindchange="progress">{{progressLabels[progressIndex]}}</picker><view class="label">课堂说明</view><textarea value="{{draft.classroomNote}}" data-field="classroomNote" bindinput="text"/><view class="label">个性点评</view><textarea value="{{draft.comment}}" data-field="comment" bindinput="text"/><view class="label">原始语音观察（最多 60 秒）</view><button wx:if="{{!recording}}" class="secondary" bindtap="startAudio" disabled="{{busy}}">开始录音</button><button wx:else bindtap="stopAudio">结束录音并上传</button><button wx:if="{{failedAudio}}" class="secondary" bindtap="retryAudio" disabled="{{busy}}">重试录音上传</button><view class="muted">已附加 {{draft.audioMediaIds.length}} 段原始录音；离开页面会停止并丢弃进行中的录音。</view><button bindtap="choose" disabled="{{busy}}">拍摄或选择作品</button><button wx:if="{{failed.length}}" class="secondary" bindtap="retry" disabled="{{busy}}">重试 {{failed.length}} 个失败文件</button><view wx:for="{{draft.artworks}}" wx:key="id" class="divider"><input value="{{item.title}}" data-index="{{index}}" data-field="title" bindinput="artwork"/><button class="secondary" size="mini" data-index="{{index}}" bindtap="stage">{{item.kind==='PROCESS'?'过程作品':'最终成品'}} · 点击切换</button><textarea value="{{item.story}}" placeholder="孩子的创作故事" data-index="{{index}}" data-field="story" bindinput="artwork"/></view><button bindtap="save" disabled="{{busy || !dirty}}" loading="{{busy}}">保存云端草稿</button><button class="secondary" bindtap="preview" disabled="{{busy || dirty}}">预览家庭课效</button><view class="muted" wx:if="{{dirty}}">请先保存后预览。重新打开将放弃未保存修改。</view><button class="secondary" bindtap="load" disabled="{{busy}}">重新打开最新版本</button></view><view wx:if="{{preview}}" class="card"><view class="title">家庭课效预览</view><view>{{draft.classroomNote}}</view><block wx:for="{{images}}" wx:key="id"><video wx:if="{{item.kind==='video'}}" src="{{item.url}}" controls class="image"/><audio wx:elif="{{item.kind==='audio'}}" src="{{item.url}}" controls/><image wx:else class="image" bindtap="image" data-url="{{item.url}}" src="{{item.displayUrl || item.url}}" mode="widthFix"/></block><view>{{draft.comment}}</view><button bindtap="publish" disabled="{{busy}}">确认发布给家庭</button></view><view class="card" wx:if="{{record}}"><view class="title">本次课堂动态</view><picker range="{{lessonLabels}}" value="{{lessonIndex}}" bindchange="entryLesson">{{lessonLabels[lessonIndex] || '尚未关联实际课次'}}</picker><textarea value="{{entryNotes}}" bindinput="entryNotes" placeholder="这一次课堂中的发现与进展"/><view class="label">勾选属于本次课堂的照片</view><checkbox-group bindchange="entryPhotos"><view wx:for="{{draft.artworks}}" wx:for-item="art" wx:key="id"><label wx:for="{{art.mediaIds}}" wx:for-item="mediaId" wx:key="*this"><checkbox value="{{mediaId}}"/>{{art.title}}</label></view></checkbox-group><view class="muted">单次动态与完整主题课效分别发布。</view><button class="secondary" bindtap="saveEntry" disabled="{{busy || !entryNotes || !lessonIds.length}}">保存本次课堂草稿</button><view wx:for="{{entries}}" wx:key="id" class="divider"><view>{{item.notes}}</view><view class="muted">{{item.status==='PUBLISHED'?'家庭可见':'草稿'}} · {{item.occurredAt}}</view><button wx:if="{{item.status==='DRAFT'}}" class="secondary" data-id="{{item.id}}" bindtap="publishEntry" disabled="{{busy}}">发布这次课堂动态</button></view></view></view>
