<view class="page"><view class="title">订单与售后</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{success}}" class="success">{{success}}</view><button class="secondary" bindtap="load" disabled="{{busy}}">刷新订单列表</button><view class="card" wx:if="{{selected}}"><view class="title">{{selected.productTitle}}</view><view>数量 {{selected.quantity}} · 合计 ¥ {{selected.totalText}}</view><view class="divider">{{selected.paymentLabel}} · {{selected.fulfillmentLabel}}</view><view class="muted">订单 {{selected.id}}</view><view wx:if="{{selected.productType==='COURSE'}}" class="muted">{{selected.lessonUnits}} 课时，权益发放与支付结果分别确认。</view><view wx:if="{{selected.productType==='PHYSICAL'}}"><view>交付方式：{{selected.fulfillmentMethod==='DELIVERY'?'配送到家':'画室自提'}}</view><view wx:if="{{selected.address}}" class="muted">{{selected.recipientName}} · {{selected.recipientPhone}}<view>{{selected.address}}</view></view><view wx:if="{{selected.trackingNumber}}">物流单号：{{selected.trackingNumber}}</view></view><button wx:if="{{selected.paymentStatus==='UNPAID'}}" bindtap="pay" disabled="{{busy}}" loading="{{busy}}">微信支付 ¥ {{selected.totalText}}</button><button class="secondary" bindtap="refresh" disabled="{{busy}}">刷新支付与交付结果</button><button wx:if="{{selected.paymentStatus==='UNPAID'}}" class="secondary" bindtap="cancel" disabled="{{busy}}">取消未支付订单</button><view class="label">退款或售后原因</view><textarea value="{{reason}}" bindinput="reason" placeholder="请描述需要画室处理的问题"/><button wx:if="{{selected.paymentStatus==='PAID'}}" class="secondary" bindtap="refund" disabled="{{busy || !reason}}">申请整单退款</button><view class="muted">已使用的课时、已发货或已核销商品，请提交售后由画室处理。</view><button class="secondary" bindtap="aftersale" disabled="{{busy || !reason}}">提交售后</button><view wx:for="{{refunds}}" wx:key="id" class="divider"><view>退款 ¥ {{item.amountText}} · {{item.statusLabel}}</view><view class="muted">{{item.reason}}</view></view><view wx:for="{{aftersales}}" wx:key="id" class="divider"><view>{{item.reason}}</view><view class="muted">{{item.response || '等待画室处理'}} · {{item.status==='CLOSED'?'已结束':item.status==='PROCESSING'?'处理中':'待处理'}}</view></view></view><view class="card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="select"><view>{{item.productTitle}} × {{item.quantity}}</view><view class="row"><view>¥ {{item.totalText}}</view><view class="tag">{{item.paymentLabel}}</view></view><view class="muted">{{item.fulfillmentLabel}} · {{item.createdAt}}</view></view><view wx:if="{{!orders.length && !busy}}" class="card muted">还没有订单。</view></view>
