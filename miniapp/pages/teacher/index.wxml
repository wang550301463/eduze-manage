<view class="page"><view class="eyebrow">TEACHER STUDIO</view><view class="title">今日教学</view><view class="error" wx:if="{{error}}">{{error}}<button class="secondary" bindtap="load">重试</button></view><view class="card"><view>本周课堂</view><view wx:for="{{lessons}}" wx:key="id" class="divider"><view>{{item.classGroupName}} · {{item.courseName}}</view><view class="muted">{{item.startAt}}</view></view><view wx:if="{{!lessons.length}}" class="muted">本周暂无课堂安排。</view></view><view class="card"><view>班级主题</view><view wx:for="{{themes}}" wx:key="id" class="divider" data-id="{{item.id}}" bindtap="theme"><view>{{item.content.title}}</view><view class="muted">{{item.content.lessonIds.length}} 课次 · {{item.status==='FINISHED'?'已结束':item.status==='IN_PROGRESS'?'进行中':'计划中'}}</view></view></view><view class="card" wx:if="{{theme}}"><view class="title">{{theme.content.title}}</view><view class="label">教学目标</view><view>{{theme.template.goals}}</view><view class="label">材料准备</view><view>{{theme.template.materials}}</view><view wx:for="{{theme.template.steps}}" wx:key="index" class="divider"><view>第 {{index+1}} 课次 · {{item.title}}</view><view class="muted">{{item.content}}</view></view><view class="label">代课与进度交接</view><view>{{theme.content.handoffNote || '暂无交接备注'}}</view></view><view class="card" wx:if="{{themeId}}"><view>学生课效</view><view wx:for="{{roster}}" wx:key="studentId" class="divider row"><view>{{item.name}}<view class="muted">{{item.status==='PUBLISHED'?'已发布':'待整理'}}</view></view><button size="mini" data-id="{{item.studentId}}" bindtap="record" disabled="{{busy}}">记录作品</button></view></view></view>
