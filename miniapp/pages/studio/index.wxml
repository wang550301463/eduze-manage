<view class="page"><view class="eyebrow">A PLACE TO CREATE</view><view class="title">发现我们的画室</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{success}}" class="success">{{success}}</view><picker range="{{studios}}" range-key="name" bindchange="branch">{{studio.name || '选择画室'}}</picker><view class="card" wx:if="{{studio}}"><view class="title">{{studio.name}}</view><view class="muted">{{studio.description}}</view><view class="divider">{{studio.address}}</view><button class="secondary" bindtap="phone">电话咨询 · {{studio.phone}}</button><button class="secondary" open-type="share">分享画室给朋友</button><button bindtap="shop">课程、活动与画材商城</button></view><view class="card" wx:if="{{studio}}"><view class="row"><button class="secondary" data-intent="咨询课程" bindtap="intent">咨询课程</button><button class="secondary" data-intent="预约试听" bindtap="intent">预约试听</button></view><view class="title">{{intent}}</view><view class="label">孩子姓名</view><input value="{{studentName}}" data-field="studentName" bindinput="field"/><view class="label">孩子年龄</view><input type="number" value="{{age}}" data-field="age" bindinput="field"/><view class="label">联系电话</view><input type="number" value="{{phone}}" data-field="phone" bindinput="field"/><button bindtap="enquire" disabled="{{busy || !studentName || !phone}}" loading="{{busy}}">提交{{intent}}意向</button><view class="muted">试听课次由画室确认后联系您。请勿重复提交相同联系方式。</view></view><view class="card" wx:for="{{activities}}" wx:key="id"><view class="title">{{item.title}}</view><view>{{item.description}}</view><view class="muted">{{item.startsAt}} · 已报名 {{item.reserved}} / {{item.capacity}}</view><button class="secondary" data-id="{{item.id}}" bindtap="signup" disabled="{{busy || item.reserved>=item.capacity}}">报名免费活动</button></view><view class="card" wx:if="{{signups.length}}"><view class="title">我的活动报名</view><view wx:for="{{signups}}" wx:key="id" class="divider"><view>{{item.activityTitle}}</view><view class="muted">{{item.startsAt}} · {{item.status==='CONFIRMED'?'已报名':item.status==='CHECKED_IN'?'已签到':'已取消'}}</view><button wx:if="{{item.status==='CONFIRMED'}}" class="secondary" data-id="{{item.id}}" bindtap="cancel" disabled="{{busy}}">取消报名</button></view></view><view wx:if="{{!studios.length && !busy}}" class="card muted">画室主页还在准备中。</view></view>
