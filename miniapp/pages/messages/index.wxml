<view class="page"><view class="title">消息与通知</view><view class="muted">阅读与确认分别记录，重要安排请及时确认。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{success}}" class="success">{{success}}</view><button class="secondary" bindtap="subscribe">设置微信订阅通知</button><view class="card" wx:for="{{messages}}" wx:key="id"><view>{{item.title}}</view><view class="muted">{{item.createdAt}}</view><view class="divider">{{item.body}}</view><view class="muted">{{item.readAt?'已读':'未读'}} · {{item.confirmedAt?'已确认':'待确认'}}</view><button class="secondary" data-id="{{item.id}}" bindtap="business">查看相关内容</button><button wx:if="{{!item.readAt}}" class="secondary" data-id="{{item.id}}" bindtap="read" disabled="{{busy}}">标记已读</button><button wx:if="{{!item.confirmedAt}}" data-id="{{item.id}}" bindtap="confirm" disabled="{{busy}}">确认收到</button></view><view class="card muted" wx:if="{{!messages.length}}">当前没有消息。</view></view>
