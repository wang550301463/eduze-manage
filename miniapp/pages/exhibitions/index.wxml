<view class="page"><view class="eyebrow">ART THROUGH THEIR EYES</view><view class="title">画室线上展览</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load">重试</button></view><view class="card" wx:for="{{exhibitions}}" wx:key="id"><view class="title">{{item.title}}</view><view class="muted">{{item.introduction}}</view><button class="secondary" data-id="{{item.id}}" bindtap="visit" disabled="{{busy}}">走进展览</button></view><view class="card" wx:if="{{selected}}"><view class="title">{{selected.title}}</view><view>{{selected.introduction}}</view><button class="secondary" open-type="share">分享这场作品展</button><button class="secondary" bindtap="shareCard" disabled="{{busy}}">生成展览分享卡</button><button class="secondary" bindtap="studio">了解画室 / 预约试听</button><view wx:for="{{works}}" wx:key="publicationId" class="divider"><view>{{item.displayName}}</view><button class="secondary" size="mini" data-id="{{item.publicationId}}" bindtap="certificate" disabled="{{busy}}">生成参展证书</button><view wx:for="{{item.artworks}}" wx:for-item="artwork" wx:key="title"><block wx:for="{{artwork.images}}" wx:for-item="picture" wx:key="id"><video wx:if="{{picture.kind==='video'}}" src="{{picture.url}}" controls class="image"/><audio wx:elif="{{picture.kind==='audio'}}" src="{{picture.url}}" controls/><image wx:else src="{{picture.displayUrl || picture.url}}" bindtap="image" data-url="{{picture.url}}" class="image" mode="widthFix"/></block><view>{{artwork.title}}</view><view class="muted">{{artwork.story}}</view></view></view></view><view class="card muted" wx:if="{{!exhibitions.length}}">画室正在筹备下一场展览，敬请期待。</view><view class="card" wx:if="{{exportPath}}"><image src="{{exportPath}}" class="image" mode="widthFix" binderror="previewFailed"/><view class="muted">{{exportName}}</view><button class="secondary" bindtap="shareFile">分享导出文件</button></view></view>
