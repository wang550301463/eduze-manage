<view class="page"><view class="eyebrow">A CHILD'S CREATIVE JOURNEY</view><view class="title">成长报告与精选作品</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{success}}" class="success">{{success}}</view><button class="secondary" bindtap="load" disabled="{{busy}}">刷新成长档案</button><view class="card" wx:if="{{opened}}"><view class="title">历史学习回顾</view><view class="muted">{{opened.createdAt}}</view><view>{{opened.content.classroomNote}}</view><block wx:for="{{images}}" wx:key="id"><video wx:if="{{item.kind==='video'}}" src="{{item.url}}" controls class="image"/><audio wx:elif="{{item.kind==='audio'}}" src="{{item.url}}" controls/><image wx:else bindtap="image" data-url="{{item.url}}" src="{{item.displayUrl || item.url}}" mode="widthFix" class="image"/></block><view class="label">老师寄语</view><view>{{opened.content.comment}}</view></view><view class="card" wx:for="{{reports}}" wx:for-item="report" wx:key="id"><view class="title">{{report.title}}</view><view>{{report.summary}}</view><view wx:for="{{report.publications}}" wx:key="id" class="divider"><view>{{item.content.classroomNote || '主题学习回顾'}}</view><button class="secondary" data-report="{{report.id}}" data-id="{{item.id}}" bindtap="snapshot" disabled="{{busy}}">查看报告中的固定作品版本</button></view></view><view class="card"><view class="title">为孩子整理精选集</view><view class="muted">精选集仅家庭可见。公开参展需要另外授权。每个精选集最多 100 个不同媒体文件。</view><input value="{{title}}" data-field="title" bindinput="field" placeholder="精选集名称"/><textarea value="{{summary}}" data-field="summary" bindinput="field" placeholder="一起回顾这段创作经历"/><checkbox-group bindchange="select"><view wx:for="{{publications}}" wx:key="id" class="divider"><label><checkbox value="{{item.id}}"/>{{item.content.classroomNote || '主题学习回顾'}}</label><view class="muted">{{item.createdAt}}</view><button class="secondary" data-id="{{item.id}}" bindtap="snapshot" disabled="{{busy}}">查看作品</button></view></checkbox-group><button bindtap="create" disabled="{{busy || !title || !selectedIds.length}}">保存私人精选作品集</button></view><view class="card" wx:for="{{collections}}" wx:for-item="collection" wx:key="id"><view class="title">{{collection.title}}</view><view>{{collection.summary}}</view><button wx:for="{{collection.publications}}" wx:key="id" class="secondary" data-collection="{{collection.id}}" data-id="{{item.id}}" bindtap="snapshot" disabled="{{busy}}">{{item.content.classroomNote || '查看精选作品'}}</button></view></view>
