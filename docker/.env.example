# 复制为 docker/.env 后修改（勿提交真实密钥）
APP_VERSION=latest

DB_NAME=eduze
DB_USER=eduze
DB_PASSWORD=change-me-strong-password
# 生产 compose 不再映射宿主机端口；仅开发 compose 使用
DB_PORT=3306

# 生产 compose 不再映射宿主机端口；仅开发 compose 使用
REDIS_PORT=6379
# 必填，非空；与 redis --requirepass / healthcheck AUTH 一致
REDIS_PASSWORD=change-me-redis-password

# JWT_SECRET 至少 32 字符（HMAC 签名密钥）
JWT_SECRET=change-me-jwt-secret-at-least-32-chars!!

# 生产首次启动：若库内仍是默认 admin/admin@123，必须设置下列两项以轮换超管
# BOOTSTRAP_ADMIN_PASSWORD 至少 12 字符；轮换成功后可从 .env 移除
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password-12+

HTTP_PORT=80
HTTPS_PORT=443
